datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Owner {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  draftSlot Int        @default(1)
  picks     DraftPick[]
}

model Country {
  id        Int         @id @default(autoincrement())
  name      String
  fifaCode  String      @unique
  group     String

  // ⭐ Stats fields from API-Football
  played        Int      @default(0)
  wins          Int      @default(0)
  draws         Int      @default(0)
  losses        Int      @default(0)
  goalsFor      Int      @default(0)
  goalsAgainst  Int      @default(0)
  goalDiff      Int      @default(0)
  points        Int      @default(0)
  rank          Int      @default(0)

  picks     DraftPick[]
}

model DraftPick {
  id         Int     @id @default(autoincrement())
  owner      Owner   @relation(fields: [ownerId], references: [id])
  ownerId    Int
  country    Country @relation(fields: [countryId], references: [id])
  countryId  Int
  round      Int
  pickNumber Int
}

model SyncMeta {
  id          Int      @id @default(1)
  lastUpdated DateTime @default(now())
}

model Settings {
  id                    Int     @id @default(autoincrement())
  draftType             String  @default("Snake") // "snake" or "linear"
  rounds                Int     @default(5)
  commissionerPassword  String
  pickClockSeconds      Int     @default(60)
  warningSeconds        Int     @default(15)
}
